{
    "functions": {
        "api/whatsapp.js": { "maxDuration": 30 },
        "api/telegram.js": { "maxDuration": 30 },
        "api/comercial/client.js": { 
            "includeFiles": "dist/index.html",
            "maxDuration": 30
        },
        "api/portfolio.js": {
            "includeFiles": "dist/index.html"
        },
        "api/presupuesto.js": {
            "includeFiles": "dist/index.html"
        },
        "api/comercial/admin.js": { "maxDuration": 30 },
        "api/lang-serve.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.nexofilm.com" }],
            "destination": "https://nexofilm.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        { "source": "/portal/login", "destination": "/index.html" },
        { "source": "/portal", "destination": "/api/comercial/client?action=render" },
        { "source": "/presupuesto", "destination": "/api/presupuesto" },
        { "source": "/portfolio/:id", "destination": "/api/portfolio" },
        { "source": "/api/(.*)", "destination": "/api/$1" },
        {
            "source": "/",
            "has": [{ "type": "query", "key": "lng", "value": "en" }],
            "destination": "/api/lang-serve?lng=en"
        },
        {
            "source": "/",
            "has": [{ "type": "query", "key": "lng", "value": "pt" }],
            "destination": "/api/lang-serve?lng=pt"
        },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ],
    "crons": [{ "path": "/api/cron", "schedule": "0 3 * * *" }]
}